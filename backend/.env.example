# Copy to .env. Defaults work for local development without this file.
ENV=dev
DATABASE_URL=sqlite:///./reimbursement.db
# Postgres (docker compose up -d db):
# DATABASE_URL=postgresql+psycopg://reimb:reimb@localhost:5434/reimb
JWT_SECRET=change-me-to-a-long-random-string
UPLOAD_DIR=./uploads
APP_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173"]
# Leave SMTP_HOST empty to log emails instead of sending them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=reimbursements@verve.example
